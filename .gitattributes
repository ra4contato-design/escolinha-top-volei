# Normaliza quebras de linha: LF no repositório, nativo na máquina local.
# Evita conflito entre Windows (CRLF) e o CI, que roda Linux (LF).
* text=auto eol=lf

# Arquivos binários: nunca alterar
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
