---
import { linkWhatsApp } from "../data/conteudo";
---

<a
  class="zap"
  href={linkWhatsApp()}
  target="_blank"
  rel="noopener"
  aria-label="Falar com a Escolinha Top Vôlei no WhatsApp"
>
  <svg class="zap__icone" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
    <path
      d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.4-.07-.13-.27-.2-.57-.35z"
    ></path>
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.41a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23z"
    ></path>
  </svg>
  <span class="zap__texto">Fale conosco</span>
</a>

<style>
  .zap {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: var(--z-flutuante);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    /* Tamanho mínimo confortável para o dedo */
    min-height: 56px;
    padding: 0 1.25rem;
    border-radius: var(--r-pilula);
    background: #25d366;
    color: #06351a;
    font-weight: 700;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.35);
    /* Entra deslizando de baixo quando a página abre */
    animation: entrarZap var(--d-lenta) var(--e-elastica) 900ms backwards;
    transition:
      transform var(--d-rapida) var(--e-suave),
      box-shadow var(--d-rapida) var(--e-suave);
  }

  @keyframes entrarZap {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.85);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .zap__icone {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }

  @media (hover: hover) {
    .zap:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 32px rgba(37, 211, 102, 0.45);
    }
  }

  .zap:active {
    transform: scale(0.96);
  }

  /* No celular vira só o ícone redondo, para não cobrir o conteúdo */
  @media (max-width: 560px) {
    .zap {
      padding: 0;
      width: 56px;
      justify-content: center;
    }

    .zap__texto {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zap {
      animation: none;
    }
  }
</style>
