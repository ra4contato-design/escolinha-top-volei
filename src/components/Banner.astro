---
import { projeto, aulas, local, linkWhatsApp } from "../data/conteudo";

const destaques = [
  { valor: "Gratuito", rotulo: "Sempre foi, sempre será" },
  { valor: `${aulas.idadeMinima} a ${aulas.idadeMaxima} anos`, rotulo: "Meninos e meninas" },
  { valor: aulas.dias, rotulo: aulas.horario },
];
---

<section class="banner" id="inicio">
  <!-- Camadas de fundo decorativas. aria-hidden esconde de leitores de tela,
       porque são enfeite e não informação. -->
  <div class="banner__fundo" aria-hidden="true">
    <div class="banner__brilho banner__brilho--1"></div>
    <div class="banner__brilho banner__brilho--2"></div>
    <div class="banner__areia"></div>
  </div>

  <div class="container banner__interno">
    <p class="banner__selo revelar">
      <span class="banner__ponto"></span>
      Projeto social · {local.bairro}, {local.cidade}
    </p>

    <h1 class="banner__titulo revelar revelar--1">
      Vôlei de areia <em>gratuito</em> para crianças e adolescentes
    </h1>

    <p class="banner__texto revelar revelar--2">
      A {projeto.nome} ensina vôlei de graça na {local.nome}, e cobra só uma
      coisa em troca: que a criança continue indo bem na escola.
    </p>

    <div class="banner__acoes revelar revelar--3">
      <a
        href={linkWhatsApp()}
        class="botao botao--principal"
        target="_blank"
        rel="noopener"
      >
        Inscrever pelo WhatsApp
      </a>
      <a href="#sobre" class="botao botao--secundario"> Conhecer o projeto </a>
    </div>

    <dl class="banner__destaques revelar revelar--4">
      {
        destaques.map((item) => (
          <div class="banner__destaque">
            <dt>{item.valor}</dt>
            <dd>{item.rotulo}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="banner__valores revelar revelar--4">
      {projeto.valores.map((valor) => <li>{valor}</li>)}
    </ul>
  </div>
</section>

<style>
  .banner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-top: 100px;
    padding-bottom: var(--e-6);
    overflow: hidden;
  }

  .banner__fundo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Manchas de luz coloridas ao fundo, bem suaves */
  .banner__brilho {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.4;
  }

  .banner__brilho--1 {
    width: 480px;
    height: 480px;
    background: var(--azul-vivo);
    top: -140px;
    right: -100px;
  }

  .banner__brilho--2 {
    width: 380px;
    height: 380px;
    background: var(--dourado);
    bottom: -120px;
    left: -120px;
    opacity: 0.22;
  }

  /* Faixa cor de areia na base, lembrando a quadra */
  .banner__areia {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 28%;
    background: linear-gradient(
      to top,
      rgba(232, 220, 198, 0.16),
      transparent
    );
  }

  .banner__interno {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }

  .banner__selo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--borda);
    border-radius: var(--r-pilula);
    background: rgba(255, 255, 255, 0.05);
    font-size: var(--t-pequeno);
    font-weight: 500;
    color: var(--texto-suave);
    margin-bottom: var(--e-3);
  }

  .banner__ponto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--destaque);
    animation: piscar 2.4s ease-in-out infinite;
  }

  @keyframes piscar {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.82); }
  }

  .banner__titulo {
    font-size: var(--t-gigante);
    margin-bottom: var(--e-3);
  }

  .banner__titulo em {
    font-style: normal;
    color: var(--destaque);
    /* Risco dourado atrás da palavra */
    background-image: linear-gradient(
      transparent 62%,
      rgba(222, 178, 53, 0.22) 62%
    );
  }

  .banner__texto {
    font-size: var(--t-subtitulo);
    color: var(--texto-suave);
    max-width: 58ch;
    margin-bottom: var(--e-4);
  }

  .banner__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    margin-bottom: var(--e-5);
  }

  .banner__destaques {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--e-3);
    padding-top: var(--e-4);
    border-top: 1px solid var(--borda);
    max-width: 640px;
  }

  .banner__destaque dt {
    font-family: var(--fonte-titulo);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--destaque);
    line-height: 1.2;
  }

  .banner__destaque dd {
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
    margin-top: 0.2rem;
  }

  /* Os quatro valores do brasão, em fila */
  .banner__valores {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.1rem;
    list-style: none;
    margin-top: var(--e-3);
  }

  .banner__valores li {
    position: relative;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--destaque);
  }

  /* Ponto dourado separando as palavras */
  .banner__valores li:not(:last-child)::after {
    content: "";
    position: absolute;
    right: -0.65rem;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
    transform: translateY(-50%);
  }

  @media (max-width: 640px) {
    .banner {
      min-height: auto;
      padding-top: 120px;
      padding-bottom: var(--e-5);
    }

    .banner__destaques {
      grid-template-columns: 1fr;
      gap: var(--e-2);
    }

    .banner__destaque {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
    }

    .banner__destaque dd {
      margin-top: 0;
    }

    .banner__acoes .botao {
      width: 100%;
    }
  }
</style>
